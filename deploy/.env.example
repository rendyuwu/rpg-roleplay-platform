# RPG Server — docker-compose 部署变量(deploy/docker-compose.yml 读取)
# 用法:cp .env.example .env && 填入各值(勿 commit .env,已被 .gitignore 忽略)

# ── 必填:数据库/Redis 口令(强口令,勿用弱口令)──────────────────────────
# openssl rand -hex 16
# 注意:该口令会拼进 DATABASE_URL,只允许 [A-Za-z0-9._-],避免 URL 转义问题
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── 必填:用户 API key 加密主密钥(32 字节 hex)────────────────────────────
# openssl rand -hex 32 —— 泄露 = 所有用户存的 API key 可解密;轮换需重加密存量
RPG_MASTER_KEY=

# ── 可选:CORS 来源(逗号分隔,须带协议与端口)─────────────────────────────
# 同源访问(后端直接挂 frontend/dist)可留空;经反代/LAN/VPN 访问时填真实来源,
# 否则浏览器发起的写请求会被 Origin 守卫拒(403 Origin 不在允许列表)。
# RPG_CORS_ORIGINS=https://your-domain.example,http://192.168.1.4:7860
# 明文 HTTP(内网/VPN)访问时关掉 Cookie Secure;HTTPS 下保持 1
# RPG_COOKIE_SECURE=0

# ── 可选:多用户/公开部署(注册需邮箱验证码)───────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM=Your Name <noreply@your-domain.example>
# 首个注册者拿 admin 的一次性令牌:openssl rand -hex 32(建完 admin 后删除并重启)
# RPG_SETUP_TOKEN=
# 多 worker 必须显式设同一值,否则验证码跨 worker 校验失败(见 rpg/.env.example)
# EMAIL_CODE_SECRET=

# ── 可选:服务器级 LLM / Embedding 兜底(普通用户走 BYOK 各自密钥)─────────
# ANTHROPIC_API_KEY=
# EMBED_BASE_URL=
# EMBED_MODEL=text-embedding-004
# EMBED_API_KEY=
